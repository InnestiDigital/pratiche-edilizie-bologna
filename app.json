{
  "expo": {
    "name": "Pratiche Edilizie Bologna",
    "slug": "pratiche-edilizie-bologna",
    "version": "1.1.2",
    "scheme": "pratiche-bologna",
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#9B2335"
        }
      ],
      "expo-font"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#9B2335"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "it.innesti.praticheediliziebologna",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "it",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "background-permit-sync"
        ]
      },
      "buildNumber": "7"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#9B2335"
      },
      "package": "it.innesti.praticheediliziebologna",
      "versionCode": 2
    },
    "locales": {
      "it": "./assets/lang/it.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c0d7122d-e3bf-4813-98ba-b68f02d8da80"
      }
    },
    "owner": "mottaviani.dev"
  }
}
